  "requirements": [
    {
      "id": "P10-CONTENT",
      "text": "Сохранить состав и визуальную систему актуальной Figma Page10; оставить только главную, перевести активные ссылки и прежние входящие адреса к ее разделам/диалогам или официальным внешним сервисам.",
      "required": true,
      "allow_na": false
    },
    {
      "id": "P10-RESPONSIVE",
      "text": "Проверить композицию, кириллические переносы, изображения, кнопки и отсутствие непреднамеренных перекрытий на десктопных и мобильных размерах.",
      "required": true,
      "allow_na": false
    },
    {
      "id": "P10-THEME",
      "text": "Реализовать светлую и темную темы и проверить читаемость тематических поверхностей, текста, логотипов и контролов.",
      "required": true,
      "allow_na": false
    },
    {
      "id": "P10-EFFECTS-INTEGRATION",
      "text": "Сохранить подключение существующих анимаций и визуальных эффектов в обновленную главную и корректную очистку ресурсов.",
      "required": true,
      "allow_na": false
    },
    {
      "id": "P10-ASSETS",
      "text": "Использовать правильные оригинальные локальные изображения и логотипы, сохранить качество оптимизированной графики и подключить Manrope с лицензией.",
      "required": true,
      "allow_na": false
    },
    {
      "id": "P10-CONTENT-LIMITS",
      "text": "Показывать датированный срез торгов и честное поведение формы без ложного заявления о живом API, подключенной CRM или отправленной заявке.",
      "required": true,
      "allow_na": false
    },
    {
      "id": "P10-BUILD-DELIVERY",
      "text": "Успешно собрать актуальную главную и подтвердить публикацию правильной версии по HTTPS на debtprice.imon.world.",
      "required": true,
      "allow_na": false
    },
    {
      "id": "P10-CONSULTATION-MASK",
      "text": "Перепроверить финальную измененную композицию масок консультации на опубликованном кандидате.",
      "required": true,
      "allow_na": false
    },
    {
      "id": "P10-LIVE",
      "text": "Завершить полный живой интерактивный прогон навигации, клавиатуры, темы, фильтров, каруселей, модальных окон, формы и сохраненных эффектов.",
      "required": true,
      "allow_na": false
    },
    {
      "id": "P10-SAFARI",
      "text": "Выполнить финальную приемку компоновки и существенных взаимодействий в реальном Safari.",
      "required": true,
      "allow_na": false
    },
    {
      "id": "P10-PRODUCTION-BOUNDARY",
      "text": "Публиковать главную на отдельном поддомене, без изменения боевого debtprice.market.",
      "required": true,
      "allow_na": false
    },
    {
      "id": "P10-HANDOFF",
      "text": "Сохранить проверяемую проектную сдачу с версиями, источниками, фактическим покрытием и явным разделением pass и blocked.",
      "required": true,
      "allow_na": false
